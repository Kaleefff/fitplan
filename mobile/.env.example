# Copy to `.env` (git ignores it) and pick the line for where the app runs.
# Restart `npx expo start` after changing it.

# Real backend (uvicorn on port 8000), seen from the Android emulator
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Real backend from a phone in the same Wi-Fi: your computer's IP address, and start
# the backend with `--host 0.0.0.0`
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api/v1

# Mock server of this repo (`npm run mock`, port 4010)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4010/api/v1
