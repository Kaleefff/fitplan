POSTGRES_DB=fitplan
POSTGRES_USER=fitplan
POSTGRES_PASSWORD=X
POSTGRES_PORT=5432

MONGO_USER=fitplan
MONGO_PASSWORD=X
MONGO_PORT=27017

# Host ports of the backend container and the dev mail catcher (Mailpit)
BACKEND_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

POSTGRES_HOST=localhost
MONGO_HOST=localhost
MONGO_DB=fitplan
LOG_LEVEL=INFO
SMTP_HOST=localhost
SMTP_PORT=1025

# Folder of the meal photos, stored as meals/<user id>/<uuid>.<ext> (api-rules.md
# "Recognition"); the cleanup job deletes orphans in it. Keep it outside the repository.
PHOTO_DIR=

# Required for auth: at least 32 random bytes, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ai-service (A-01, D25). The key comes from a Google project with billing enabled (paid
# tier). Never commit a real key. Only the ai-service container gets it; without one
# ai-service still starts, /health answers 503 and /predict 503 not_configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Seconds for the whole Gemini call, the one retry included; below the 10 s of NFR-PERF.
GEMINI_TIMEOUT_S=7
# Photo detail sent to Gemini: low | medium | high
GEMINI_MEDIA_RESOLUTION=medium
# Gemini thinking: minimal | low | medium | high
GEMINI_THINKING_LEVEL=minimal

# How the backend reaches ai-service. Compose sets http://ai-service:8001 for the backend
# container; a backend run on the host needs ai-service run on the host too.
AI_SERVICE_URL=http://localhost:8001
